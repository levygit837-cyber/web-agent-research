#!/bin/sh
# Local block on direct pushes to main (ADR-0005).
# GitHub's native protection needs a paid plan on this private repo;
# this hook is the only real block until migration. Enable with:
#   git config core.hooksPath .githooks
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "blocked: direct push to main. Open a PR (see ADR-0005)." >&2
      echo "to regularize a push already made, use a revert PR." >&2
      exit 1
      ;;
  esac
done
