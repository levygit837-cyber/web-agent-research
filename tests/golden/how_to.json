{
  "category": "how_to",
  "goals": [
    {
      "id": "how_to-01",
      "goal": "How do I cross-compile a Rust binary for aarch64 Linux with cargo?",
      "nuggets": [
        {
          "text": "The Rust target triple for 64-bit ARM Linux with glibc is `aarch64-unknown-linux-gnu`.",
          "scope": "core",
          "url": "https://doc.rust-lang.org/nightly/rustc/platform-support.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Install the standard library for the target with `rustup target add <target>`.",
          "scope": "core",
          "url": "https://rust-lang.github.io/rustup/cross-compilation.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Build for the target by passing the `--target` flag to Cargo, as in `cargo build --target=<triple>`.",
          "scope": "core",
          "url": "https://rust-lang.github.io/rustup/cross-compilation.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Cross-compiling typically requires tools beyond the standard library, particularly a linker for the target.",
          "scope": "core",
          "url": "https://rust-lang.github.io/rustup/cross-compilation.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "A linker for a target is configured in the Cargo config with the `target.<triple>.linker` key.",
          "scope": "core",
          "url": "https://doc.rust-lang.org/cargo/reference/config.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "The linker setting can also be given through the environment variable `CARGO_TARGET_<triple>_LINKER`.",
          "scope": "supporting",
          "url": "https://doc.rust-lang.org/cargo/reference/config.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`rustup target list` shows the available targets.",
          "scope": "supporting",
          "url": "https://rust-lang.github.io/rustup/cross-compilation.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`aarch64-unknown-linux-gnu` is a Tier 1 with Host Tools target.",
          "scope": "supporting",
          "url": "https://doc.rust-lang.org/nightly/rustc/platform-support.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-02",
      "goal": "How do I squash the last 3 commits in git?",
      "nuggets": [
        {
          "text": "Start an interactive rebase of the last three commits with `git rebase -i HEAD~3`.",
          "scope": "core",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "In the rebase todo list, keep `pick` on the first (oldest) commit.",
          "scope": "core",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "In the rebase todo list, change `pick` to `squash` on the other two commits.",
          "scope": "core",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "After saving the todo list, Git opens the editor again to merge the commit messages.",
          "scope": "core",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`fixup` is like `squash` but discards the commit's log message.",
          "scope": "supporting",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Commits you have already pushed to a shared repository should be treated as final and not rewritten.",
          "scope": "supporting",
          "url": "https://git-scm.com/book/en/v2/Git-Tools-Rewriting-History",
          "volatility": "never",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-03",
      "goal": "How do I set a default value for a column in PostgreSQL with ALTER TABLE?",
      "nuggets": [
        {
          "text": "Use the syntax `ALTER TABLE name ALTER [ COLUMN ] column_name SET DEFAULT expression`.",
          "scope": "core",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "The new default value applies only to subsequent `INSERT` or `UPDATE` commands.",
          "scope": "core",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`SET DEFAULT` does not change rows already in the table.",
          "scope": "supporting",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`ALTER COLUMN column_name DROP DEFAULT` removes the default of a column.",
          "scope": "supporting",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Removing a default is equivalent to setting the default value to NULL.",
          "scope": "supporting",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`ALTER TABLE` can combine several actions in one comma-separated list.",
          "scope": "supporting",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "With `ADD COLUMN` and a non-volatile `DEFAULT`, existing rows return the default value for the new column.",
          "scope": "supporting",
          "url": "https://www.postgresql.org/docs/current/sql-altertable.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-04",
      "goal": "How do I pin a GitHub Action to a commit SHA in my workflow?",
      "nuggets": [
        {
          "text": "Reference the action with its full commit SHA after the `@` in `uses:`.",
          "scope": "core",
          "url": "https://docs.github.com/en/actions/how-tos/write-workflows/choose-what-workflows-do/find-and-customize-actions",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "You must use a commit's full SHA value and not an abbreviated one.",
          "scope": "core",
          "url": "https://docs.github.com/en/actions/how-tos/write-workflows/choose-what-workflows-do/find-and-customize-actions",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "The SHA you select should come from the action's own repository and not from a fork.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/how-tos/write-workflows/choose-what-workflows-do/find-and-customize-actions",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Pinning to a full-length commit SHA is currently the only way to use an action as an immutable release.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/reference/security/secure-use",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "A tag can be moved or deleted if a bad actor gains access to the repository storing the action.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/reference/security/secure-use",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "With SHA pinning you do not automatically receive updates for the action.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/how-tos/write-workflows/choose-what-workflows-do/find-and-customize-actions",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "GitHub offers repository-level policies that require actions to be pinned to a full-length commit SHA.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/reference/security/secure-use",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "GitHub offers organization-level policies that require actions to be pinned to a full-length commit SHA.",
          "scope": "supporting",
          "url": "https://docs.github.com/en/actions/reference/security/secure-use",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-05",
      "goal": "How do I roll back a Kubernetes Deployment to a previous revision with kubectl?",
      "nuggets": [
        {
          "text": "List the revisions of a Deployment with `kubectl rollout history deployment/<name>`.",
          "scope": "core",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Roll back to the previous revision with `kubectl rollout undo deployment/<name>`.",
          "scope": "core",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Roll back to a specific revision with `kubectl rollout undo deployment/<name> --to-revision=<n>`.",
          "scope": "core",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Inspect the details of a specific revision with `kubectl rollout history deployment/<name> --revision=<n>`.",
          "scope": "supporting",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "By default all of the Deployment's rollout history is kept in the system.",
          "scope": "supporting",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "The amount of kept rollout history can be changed by modifying the revision history limit.",
          "scope": "supporting",
          "url": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-06",
      "goal": "How do I build only one stage of a multi-stage Dockerfile?",
      "nuggets": [
        {
          "text": "Use `docker build --target <stage-name>` to stop the build at a specific stage.",
          "scope": "core",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Name a stage by adding `AS <name>` to its `FROM` instruction.",
          "scope": "core",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Copy artifacts from an earlier stage with `COPY --from=<stage>`.",
          "scope": "supporting",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Unnamed stages can be referenced by an integer index that starts at 0 for the first `FROM` instruction.",
          "scope": "supporting",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "With BuildKit, only the stages that the target stage depends on are built.",
          "scope": "supporting",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Without BuildKit, building a target stage processes all stages.",
          "scope": "supporting",
          "url": "https://docs.docker.com/build/building/multi-stage/",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-07",
      "goal": "How do I make Node.js automatically restart my script when files change?",
      "nuggets": [
        {
          "text": "Run the script with the `--watch` flag, as in `node --watch <script>`.",
          "scope": "core",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "By default, watch mode restarts the process when the entry point or any required or imported module changes.",
          "scope": "core",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`--watch-path` specifies which paths to watch.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Using `--watch-path` turns off watching of required or imported modules.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Watch mode became stable in Node.js v22.0.0 and v20.13.0.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`--watch` requires a file path as an argument.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "`--watch` cannot be combined with `--check`, `--eval`, `--interactive`, or the REPL.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        },
        {
          "text": "If no file is provided with `--watch`, Node.js exits with status code `9`.",
          "scope": "supporting",
          "url": "https://nodejs.org/api/cli.html",
          "volatility": "slow",
          "verified_on": "2026-10-08"
        }
      ]
    },
    {
      "id": "how_to-08",
      "goal": "How do I create and activate a Python virtual environment with venv?",
      "nuggets": [
        {
          "text": "Create the environment by running the venv module with `python -m venv <path>`.",
          "scope": "core",
          "url": "https://docs.python.org/3/library/venv.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "On POSIX with bash or zsh, activate the environment with `source <venv>/bin/activate`.",
          "scope": "core",
          "url": "https://docs.python.org/3/library/venv.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "On Windows in cmd.exe, activate the environment with `<venv>\\Scripts\\activate.bat`.",
          "scope": "supporting",
          "url": "https://docs.python.org/3/library/venv.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "On Windows in PowerShell, activate the environment with `<venv>\\Scripts\\Activate.ps1`.",
          "scope": "supporting",
          "url": "https://docs.python.org/3/library/venv.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        },
        {
          "text": "Deactivate a virtual environment by typing `deactivate` in the shell.",
          "scope": "supporting",
          "url": "https://docs.python.org/3/library/venv.html",
          "volatility": "never",
          "verified_on": "2026-10-08"
        }
      ]
    }
  ]
}
